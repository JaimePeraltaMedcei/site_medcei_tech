{
  // Cloudflare Workers static site: serves the Vite build in dist/.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "medcei-tech",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "tech.medcei.pt", "custom_domain": true }]
}
